# Backend env for LOCAL (non-Docker) runs. In Docker these are injected by
# docker-compose from the root .env. Copy to backend/.env only if running
# `npm run dev` directly on the host.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://smartpay:change_me_in_prod@localhost:5432/smartpay?schema=public

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend origin(s) allowed by CORS (comma-separated).
CORS_ORIGIN=http://localhost:3000

# ── ITECpay gateway (https://pay.itecpay.rw) ────────────────────────────────
# Leave blank to use the built-in default keys; set to override per account.
ITECPAY_BASE_URL=https://pay.itecpay.rw
ITECPAY_KEY_MTN=
ITECPAY_KEY_AIRTEL=
ITECPAY_KEY_CARD=
ITECPAY_POLL_INTERVAL_MS=4000
ITECPAY_POLL_MAX_ATTEMPTS=45
