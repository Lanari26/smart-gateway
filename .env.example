# ── Root env for docker-compose (dev + prod) ────────────────────────────────
# Copy to .env and fill in real values before deploying. NEVER commit .env.

# Postgres
POSTGRES_USER=smartpay
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=smartpay

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: the frontend origin allowed to call the API.
#   dev : http://localhost:3000
#   prod: https://pay.lanari.rw
CORS_ORIGIN=https://pay.lanari.rw

# API base URL baked into the frontend bundle at build time.
#   dev : http://localhost:4000/api
#   prod: https://api-pay.lanari.rw/api
VITE_API_BASE_URL=https://api-pay.lanari.rw/api

# Local-only ports CloudPanel reverse-proxies to (prod).
WEB_PORT=3000
API_PORT=4000

# ── ITECpay gateway (https://pay.itecpay.rw) ────────────────────────────────
# Provider API keys issued at registration. The backend ships sensible
# defaults so checkout works out of the box; override here for your account.
ITECPAY_BASE_URL=https://pay.itecpay.rw
ITECPAY_KEY_MTN=
ITECPAY_KEY_AIRTEL=
ITECPAY_KEY_CARD=
# Status polling: check every N ms, give up after M attempts.
ITECPAY_POLL_INTERVAL_MS=4000
ITECPAY_POLL_MAX_ATTEMPTS=45
