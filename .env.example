# ── Root env for docker-compose (dev + prod) ────────────────────────────────
# Copy to .env and fill in real values before deploying. NEVER commit .env.

# Postgres
POSTGRES_USER=smartpay
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=smartpay

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS: the frontend origin allowed to call the API.
#   dev : http://localhost:3000
#   prod: https://pay.lanari.rw
CORS_ORIGIN=https://pay.lanari.rw

# API base URL baked into the frontend bundle at build time.
#   dev : http://localhost:4000/api
#   prod: https://api-pay.lanari.rw/api
VITE_API_BASE_URL=https://api-pay.lanari.rw/api

# Local-only ports CloudPanel reverse-proxies to (prod).
WEB_PORT=3000
API_PORT=4000

# Optional: Gemini key for the AI developer sandbox in the frontend.
GEMINI_API_KEY=
